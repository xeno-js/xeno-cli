{
  "name": "@xeno-js/cli",
  "version": "0.3.0",
  "description": "Official Xeno.JS CLI for scaffolding and generating explicit TypeScript application architecture.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeno-js/xeno-cli.git"
  },
  "bugs": {
    "url": "https://github.com/xeno-js/xeno-cli/issues"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://www.xeno-js.it",
  "keywords": [
    "typescript",
    "nodejs",
    "xeno",
    "xeno-js",
    "xeno.js",
    "application-architecture",
    "application-framework",
    "scaffolding",
    "code-generator",
    "cli",
    "ddd",
    "domain-driven-design",
    "cqrs",
    "dependency-injection",
    "clean-architecture",
    "modular-architecture",
    "vue",
    "vuejs"
  ],
  "bin": {
    "xeno-js": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --config eslint.config.mjs \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint --config eslint.config.mjs \"src/**/*.ts\" --fix --max-warnings=0",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run src",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint:fix && npm run test",
    "verify:commit": "npm run lint-staged && npm run test",
    "verify:push": "npm run check",
    "prepare": "husky",
    "changelog": "npx conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "prepublishOnly": "npm run check && npm run build",
    "release:patch": "npm version patch && npm run changelog && npm run prepublishOnly && npm publish --access public",
    "release:minor": "npm version minor && npm run changelog && npm run prepublishOnly && npm publish --access public",
    "release:major": "npm version major && npm run changelog && npm run prepublishOnly && npm publish --access public"
  },
  "author": "Xeno",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "commonjs",
  "dependencies": {
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^4.1.7",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "conventional-changelog-cli": "^5.0.0",
    "conventional-changelog-writer": "^9.2.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
